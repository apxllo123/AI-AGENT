# Web UI / Node server
PORT=8080
PYTHON_SERVICE_URL=http://127.0.0.1:8081

# Security
# The Node server listens on loopback by default. Set HOST only when you
# deliberately expose it (VPS, hosted runtime, or tunnel), and set AUTH_TOKEN so
# the private routes stay authenticated. The browser prompts for this token.
HOST=127.0.0.1
AUTH_TOKEN=
# Extra browser origins allowed to call the API, comma separated.
ALLOWED_ORIGINS=

# Tiny model / Python service
PYTHON_PORT=8081
MAX_NEW_TOKENS=180

# Optional Ollama
USE_OLLAMA=auto
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
CODER_MODEL=qwen2.5-coder
