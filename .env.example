# Web UI / Node server
PORT=8080
# 127.0.0.1 answers local requests only. Use 0.0.0.0 for a tunnel or a host.
HOST=0.0.0.0
# Required by the chat, memory, and conversation routes. Set your own value so
# the token survives a restart. Use a long random string.
ACCESS_TOKEN=
# Comma-separated browser origins that may call the API from another page.
# Leave empty unless a separate site calls this server.
ALLOWED_ORIGINS=
PYTHON_SERVICE_URL=http://127.0.0.1:8081

# Tiny model / Python service
PYTHON_PORT=8081
# The Node server is the only client of the Python service.
PYTHON_HOST=127.0.0.1
MAX_NEW_TOKENS=180

# Optional Ollama
USE_OLLAMA=auto
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
CODER_MODEL=qwen2.5-coder
